# FloodSense backend configuration.
# Copy to backend/.env and fill in. Never commit the filled-in copy.

# ── MQTT ────────────────────────────────────────────────────────
# broker.hivemq.com is PUBLIC — anyone can publish fake sensor readings to
# your topics. Use a private HiveMQ Cloud cluster (free tier) in production.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=8883                  # 8883 = TLS, 1883 = plaintext local
MQTT_USER=                      # broker username (private clusters)
MQTT_PASS=                      # broker password

# ── HTTP ────────────────────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS=*               # comma-separated origins; lock down before going public

# ── Storage ─────────────────────────────────────────────────────
DB_PATH=                        # absolute path; defaults to backend/flood_data.db

# ── Model ───────────────────────────────────────────────────────
MODEL_PATH=                     # defaults to ml_pipeline/flood_model.joblib
MODEL_CARD_PATH=                # defaults to ml_pipeline/model_card.json
RESAMPLE_WINDOW_SEC=60          # seconds of live packets that stand in for one training step
PRESSURE_TREND_WINDOW_SEC=60    # baseline window for the BMP180 hPa/hour storm-drop rule; raise on real hardware if sensor noise trips it

# ── Security (required for the dashboard's Send Alert button) ───
DASHBOARD_KEY=                  # shared secret; sent as the X-Dashboard-Key header
ALERT_RECIPIENTS=               # comma-separated E.164 allowlist, e.g. +919876543210,+15551234567
TEST_SECRET=                    # shared secret for POST /api/test-alert

# ── Twilio alerting ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+919544127372
SMS_FALLBACK_FROM=              # optional SMS-capable Twilio number; used when WhatsApp delivery fails
GLOBAL_MAX_PER_HOUR=20          # hard cap on outbound messages per hour across ALL nodes

# ── Node liveness ───────────────────────────────────────────────
NODE_STALE_SEC=60               # no telemetry for this long => node renders as NO DATA

# ── Layer 3: weather fusion (Open-Meteo forecast, free, no key) ──
NODE_COORDS=                    # "node-1:43.027,-91.173;node-2:19.076,72.877"
WEATHER_POLL_SEC=3600           # forecast cache TTL; never polled per MQTT packet
WEATHER_TIMEOUT_SEC=10

# ── Behaviour ───────────────────────────────────────────────────
DEMO_MODE=true                  # enables POST /api/simulate
WEB_CONCURRENCY=1               # MUST be 1; the app refuses to start otherwise
DISABLE_MQTT=                   # set to 1 in tests to import the app without a broker
