# Twilio Credentials (Optional for WhatsApp Alerts)
# ⚠  NEVER put real values here — this file is tracked by git.
# Copy this file to .env (which is git-ignored) and put real values there.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+91XXXXXXXXXX

# MQTT Broker Configuration
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=8883

# Flask API Port
PORT=8080

# Optional — enables POST /api/simulate (demo mode)
DEMO_MODE=false

# Optional — shared secret for POST /api/test-alert
TEST_SECRET=change-me-to-a-random-string
